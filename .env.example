# Salesforce Developer Agent — environment variables
#
# Easiest path: don't edit this by hand. Run the wizard:
#     uv run python -m sf_dev_agent setup
#
# It writes a minimal .env for you (provider + key + org alias) and validates
# the API key with a test call. Everything below is OPTIONAL — set only what
# you want to override.
# ─────────────────────────────────────────────────────────────────────────────

# ── REQUIRED: pick ONE provider and set its key ─────────────────────────────
# Provider is auto-detected from whichever key you set. Override only if you
# have multiple keys and need to disambiguate.
# LLM_PROVIDER=gemini                # anthropic | openai | gemini

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Optional: override the default model for your provider.
# Defaults: anthropic→claude-sonnet-4-6, openai→gpt-4o, gemini→gemini-2.5-flash
# LLM_MODEL=

# ── REQUIRED: which Salesforce org to target ────────────────────────────────
# Must match an alias from `sf org list`. The agent uses the sf CLI to talk to
# the org via this alias — instance URL, auth, etc. all come from sf's stored
# config, not from this file.
SF_ORG_ALIAS=

# ── OPTIONAL: overrides for auto-detected values ────────────────────────────
# Org type and instance URL are read from `sf org display` at runtime.
# API version is read from workspace/sfdx-project.json.
# Workspace path defaults to <repo>/workspace.
# Set the lines below only if you need to override the defaults.

# SF_ORG_TYPE=developer              # sandbox | scratch | production | developer
# SF_INSTANCE_URL=https://login.salesforce.com
# SF_API_VERSION=62.0
# AGENT_WORKSPACE=/absolute/path/to/your/sfdx/workspace

# ── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
