# Salesforce Developer Agent — Environment Variables
# Copy this to .env and fill in your values.

# ── LLM Provider ───────────────────────────────────────────────────────────────
# Which provider to use: anthropic | openai | gemini
# Overridable at runtime with --provider flag.
LLM_PROVIDER=gemini

# Model override (optional — each provider has a built-in default).
# Anthropic default : claude-sonnet-4-6
# OpenAI default    : gpt-4o
# Gemini default    : gemini-2.5-pro
# LLM_MODEL=

# ── API Keys (set only the one you need) ───────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# ── Salesforce org defaults (can also be passed via CLI flags) ─────────────────
SF_ORG_ALIAS=default
SF_ORG_TYPE=scratch
SF_INSTANCE_URL=https://test.salesforce.com
SF_API_VERSION=62.0

# ── Agent workspace (where files are created during a task) ───────────────────
AGENT_WORKSPACE=/tmp/agent-workspace

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
